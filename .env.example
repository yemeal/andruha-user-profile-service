# Application
SERVICE_NAME=andruha-user-profile-service
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
HOST=0.0.0.0
PORT=8002
DEV_LOGS=true
LOG_LEVEL=INFO
MUTE_LOGGERS=uvicorn.access

# PostgreSQL Database (separate components or DATABASE_URL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=andruha_profile
POSTGRES_PASSWORD=profile-local-only
POSTGRES_DB=andruha_profile
# DATABASE_URL=postgresql+asyncpg://andruha_profile:profile-local-only@127.0.0.1:5432/andruha_profile
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=5.0
DATABASE_COMMAND_TIMEOUT=10.0

# Redis / Valkey Hot Store (separate components or REDIS_URL)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://127.0.0.1:6379/0
KEY_NAMESPACE=andruha-user-profile-service:idempotency:v2

# Idempotency
IDEMPOTENCY_LEASE_SECONDS=30
IDEMPOTENCY_RESULT_TTL_SECONDS=86400
IDEMPOTENCY_CB_FAILURES=3
IDEMPOTENCY_CB_RECOVERY_SECONDS=10.0
